# Ping Pong Game (2 Players)
# Made by Sam Clark 

import turtle

# Window setup
win = turtle.Screen()
win.title("Ping Pong Game - by Sam")
win.bgcolor("black")
win.setup(width=800, height=600) 
win.tracer(0)

# Left paddle
left = turtle.Turtle()
left.speed(0)
left.shape("square")
left.color("white")
left.shapesize(stretch_wid=5, stretch_len=1)
left.penup()
left.goto(-350, 0)

# Right paddle
right = turtle.Turtle()
right.speed(0)
right.shape("square")
right.color("white")
right.shapesize(stretch_wid=5, stretch_len=1)
right.penup()
right.goto(350, 0)

# Ball
ball = turtle.Turtle()
ball.speed(0)
ball.shape("circle")
ball.color("white")
ball.penup()
ball.goto(0, 0)

#  BALL SPEED
ball.dx = 0.6
ball.dy = 0.6

# Scores
scoreL = 0
scoreR = 0

# Score text
score = turtle.Turtle()
score.speed(0)
score.color("white")
score.penup()
score.hideturtle()
score.goto(0, 260)
score.write("Left: 0    Right: 0", align="center", font=("Courier", 24, "normal"))

# Paddle speeds (for smooth movement)
left_speed = 0
right_speed = 0

# Functions to change speed
def move_left(speed):
    global left_speed
    left_speed = speed

def move_right(speed):
    global right_speed
    right_speed = speed

# Controls
win.listen()

# Left paddle (W/S)
win.onkeypress(lambda: move_left(2), "w")
win.onkeypress(lambda: move_left(-2), "s")
win.onkeyrelease(lambda: move_left(0), "w")
win.onkeyrelease(lambda: move_left(0), "s")

# Right paddle (Up/Down)
win.onkeypress(lambda: move_right(2), "Up")
win.onkeypress(lambda: move_right(-2), "Down")
win.onkeyrelease(lambda: move_right(0), "Up")
win.onkeyrelease(lambda: move_right(0), "Down")

# Main game loop
while True:
    win.update()

    # Move paddles smoothly
    left.sety(left.ycor() + left_speed)
    right.sety(right.ycor() + right_speed)

    # Keep paddles on screen
    if left.ycor() > 250:
        left.sety(250)
    if left.ycor() < -250:
        left.sety(-250)

    if right.ycor() > 250:
        right.sety(250)
    if right.ycor() < -250:
        right.sety(-250)

    # Move ball
    ball.setx(ball.xcor() + ball.dx)
    ball.sety(ball.ycor() + ball.dy)

    # Ball bounce top/bottom
    if ball.ycor() > 290:
        ball.sety(290)
        ball.dy *= -1

    if ball.ycor() < -290:
        ball.sety(-290)
        ball.dy *= -1

    # Ball goes off right side
    if ball.xcor() > 390:
        ball.goto(0, 0)
        ball.dx *= -1
        scoreL += 1
        score.clear()
        score.write(f"Left: {scoreL}    Right: {scoreR}",
                    align="center", font=("Courier", 24, "normal"))

    # Ball goes off left side
    if ball.xcor() < -390:
        ball.goto(0, 0)
        ball.dx *= -1
        scoreR += 1
        score.clear()
        score.write(f"Left: {scoreL}    Right: {scoreR}",
                    align="center", font=("Courier", 24, "normal"))

    # Paddle collision (right)
    if (340 < ball.xcor() < 350) and \
       (right.ycor() - 50 < ball.ycor() < right.ycor() + 50):
        ball.setx(340)
        ball.dx *= -1

    # Paddle collision (left)
    if (-350 < ball.xcor() < -340) and \
       (left.ycor() - 50 < ball.ycor() < left.ycor() + 50):
        ball.setx(-340)
        ball.dx *= -1

turtle.done() #loop
